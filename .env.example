# Generate a UUID with:
#   python -c "import uuid; print(uuid.uuid4())"
VLESS_UUID=replace-with-a-random-uuid

VLESS_HOST=0.0.0.0
VLESS_PORT=10086
VLESS_PATH=/vless
VLESS_LOG_LEVEL=INFO

# Host port to publish. The container listens on VLESS_PORT (default 10086).
HOST_PORT=10086

# Optional: enable TLS by mounting ./certs and uncommenting these values.
# VLESS_CERT=/certs/fullchain.pem
# VLESS_KEY=/certs/privkey.pem
